{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "rxxldq-private-insights",
  "main": "src/worker.js",
  "compatibility_date": "2026-08-27",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "vars": {
    "ALLOWED_ORIGINS": "https://rxxldq.club,https://www.rxxldq.club,https://rxxldq.github.io,http://127.0.0.1:4000,http://localhost:4000",
    "ADMIN_USERNAME": "rxxldq"
  },
  "secrets": {
    "required": ["ADMIN_PASSWORD", "RATE_SALT"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "rxxldq-insights",
      "database_id": "f1af4262-14fc-4da2-b625-c339bcb0fec4",
      "migrations_dir": "migrations"
    }
  ]
}
