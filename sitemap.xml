  <url><loc>{{ site.url }}{{ site.baseurl }}/hall-en.html</loc></url>
  <url><loc>{{ site.url }}{{ site.baseurl }}/privacy.html</loc></url>
  <url><loc>{{ site.url }}{{ site.baseurl }}/privacy-en.html</loc></url>
